# Copy to .env for local runs (docker compose / flask run). Never commit .env.
SECRET_KEY=change-me-generate-with-python-c-import-secrets-print-secrets-token-hex-32
DATABASE_URL=sqlite:////data/app.db
SESSION_COOKIE_SECURE=true
PROXY_COUNT=1

# First administrator (only applied while the operator table is empty)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-12-chars

# Keycloak - confidential client with service account (roles: view-users, manage-users, query-groups)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=account-manager
KEYCLOAK_CLIENT_SECRET=

# Jira Data Center - Personal Access Token of an administrator
JIRA_URL=https://jira.example.com
JIRA_TOKEN=

# Nextcloud - admin user + app password (Settings > Security > Devices & sessions)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=admin
NEXTCLOUD_APP_PASSWORD=
